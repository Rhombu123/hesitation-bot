DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=1529146940787523715

# Role shop (Railway public URL + HMAC for signed Discord links)
SHOP_PUBLIC_URL=https://hesitation-bot-production.up.railway.app
SHOP_LINK_SECRET=generate-a-long-random-string
SHOP_GUILD_ID=
# Stripe — Payment Links + webhook at /stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_VIP=
STRIPE_PAYMENT_LINK_ELITE=
STRIPE_PAYMENT_LINK_SUPREME=
STRIPE_PAYMENT_LINK_MYTHIC=
STRIPE_PLINK_VIP=
STRIPE_PLINK_ELITE=
STRIPE_PLINK_SUPREME=
STRIPE_PLINK_MYTHIC=

# Supabase → Project Settings → API
# Project URL is still required (keys alone are not enough).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Secret key (aka service_role) — NOT the publishable/anon key
SUPABASE_SECRET_KEY=your_secret_key_here
# Legacy alias also accepted: SUPABASE_SERVICE_ROLE_KEY

# Direct Postgres (Supabase pooler URI, port 6543). Same DB as Supabase.
DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Railway Redis (shared cooldowns across replicas)
REDIS_URL=redis://default:PASSWORD@redis.railway.internal:6379

LEVEL_UP_CHANNEL_ID=

# One Discord role passed to whoever is #1 on today's !ltop (UTC day).
TOP_MESSENGER_ROLE_ID=1532142740844839162

# Optional custom emoji IDs after uploading assets/emojis/*.png to Discord
# Format: name:id  e.g. info:1234567890123456789
EMOJI_INFO=
EMOJI_UP=
EMOJI_XP=
EMOJI_CHAT=

# Set to true only if Discord allows the bot to upload files in your server
LTOP_USE_IMAGE=false

# Main chat — Hesitation posts “use /bump for XP” reminders here.
BUMP_REMINDER_CHANNEL_ID=
# Mod/staff channel where DISBOARD /bump confirmations appear.
BUMP_DETECT_CHANNEL_ID=
# XP for a successful bump (default 100).
BUMP_XP_REWARD=100

# Klipy (action GIFs / custom Supreme actions). Optional.
KLIPY_API_KEY=
